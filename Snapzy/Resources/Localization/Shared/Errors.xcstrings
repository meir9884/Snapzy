          }
        }
      }
    },
    "crash-report.recovery.recovery-suggestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try repairing the database, reset it after backing up the existing files, or quit Snapzy."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לנסות לתקן את מסד הנתונים, לאפס אותו לאחר גיבוי הקבצים הקיימים, או לצאת מ־Snapzy."
          }
        }
      }
    },
