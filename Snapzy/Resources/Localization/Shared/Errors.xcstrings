{
  "sourceLanguage": "en",
  "strings": {
    "crash-report.accessory-hint": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Log-Bundle auf die Berichtsseite ziehen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag log bundle to the report page"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el paquete de logs a la página de informe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser le lot de journaux vers la page de rapport"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログバンドルを報告ページへドラッグ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그 묶음을 신고 페이지로 드래그하세요"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите пакет журналов на страницу отчета"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo gói log vào trang báo lỗi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将日志包拖到报告页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將日誌包拖到回報頁面"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לגרור את חבילת היומנים לדף הדיווח"
          }
        }
      }
    },
    "crash-report.alert-message": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy hat Ihre Diagnoseprotokolle in einer Datei gebündelt. Ziehen Sie die Datei unten auf die Berichtsseite."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy bundled your diagnostic logs into one file. Drag the file below to the report page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy agrupó tus logs de diagnóstico en un archivo. Arrastra el archivo siguiente a la página de informe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy a regroupé vos journaux de diagnostic dans un fichier. Faites glisser le fichier ci-dessous vers la page de rapport."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy は診断ログを1つのファイルにまとめました。下のファイルを報告ページへドラッグしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy가 진단 로그를 하나의 파일로 묶었습니다. 아래 파일을 신고 페이지로 드래그하세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy собрал журналы диагностики в один файл. Перетащите файл ниже на страницу отчета."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy đã gom log chẩn đoán thành một tệp. Hãy kéo tệp bên dưới vào trang báo lỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 已将诊断日志打包为一个文件。将下面的文件拖到报告页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 已將診斷日誌打包成一個檔案。將下面的檔案拖到回報頁面。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy איגד את יומני האבחון לקובץ אחד. יש לגרור את הקובץ שלמטה לדף הדיווח."
          }
        }
      }
    },
    "crash-report.alert-message-no-log-bundle": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy konnte kein Diagnose-Log-Bundle vorbereiten. Sie können die Berichtsseite trotzdem öffnen und das Problem beschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy could not prepare a diagnostic log bundle. You can still open the report page and describe the problem."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy no pudo preparar un paquete de logs de diagnóstico. Aun así puedes abrir la página de informe y describir el problema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy n’a pas pu préparer de lot de journaux de diagnostic. Vous pouvez quand même ouvrir la page de rapport et décrire le problème."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy は診断ログバンドルを準備できませんでした。報告ページを開いて問題を説明することはできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy가 진단 로그 묶음을 준비하지 못했습니다. 신고 페이지를 열어 문제를 설명할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy не удалось подготовить пакет журналов диагностики. Вы все равно можете открыть страницу отчета и описать проблему."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy không thể chuẩn bị gói log chẩn đoán. Bạn vẫn có thể mở trang báo lỗi và mô tả vấn đề."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 无法准备诊断日志包。你仍然可以打开报告页面并描述问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy 無法準備診斷日誌包。你仍然可以開啟回報頁面並描述問題。"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להכין חבילת יומני אבחון. עדיין אפשר לפתוח את דף הדיווח ולתאר את הבעיה."
          }
        }
      }
    },
    "crash-report.alert-title": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Problem melden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Report a Problem"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Informar de un problema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signaler un problème"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題を報告"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문제 신고"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщить о проблеме"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo vấn đề"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回報問題"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דיווח על בעיה"
          }
        }
      }
    },
    "crash-report.dismiss": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đóng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סגירה"
          }
        }
      }
    },
    "crash-report.submit": {
      "extractionState": "stale",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berichtsseite öffnen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Report Page"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir página de informe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir la page de rapport"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告ページを開く"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고 페이지 열기"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть страницу отчета"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở trang báo lỗi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开报告页面"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟回報頁面"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחת דף הדיווח"
          }
        }
      }
    },
    "crash-report.recovery.retry-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previous attempt also failed. If this keeps happening, Start Fresh will let you use Snapzy without old data."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גם הניסיון הקודם נכשל. אם הבעיה נמשכת, התחלה מחדש תאפשר להשתמש ב־Snapzy ללא הנתונים הישנים."
          }
        }
      }
    },
    "crash-report.recovery.skip-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not mark migration as skipped: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לסמן את העברת הנתונים כדילוג: %@"
          }
        }
      }
    },
    "crash-report.recovery.migration-title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy could not migrate your existing data."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy לא הצליח להעביר את הנתונים הקיימים."
          }
        }
      }
    },
    "crash-report.recovery.migration-message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy needs to move data from the old sandboxed storage before opening the unsandboxed version.\n\nNo new database was opened yet, so your existing data has not been replaced.\n\nError:\n%@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "על Snapzy להעביר נתונים מהאחסון הישן המבודד לפני פתיחת הגרסה שאינה מבודדת.\n\nעדיין לא נפתח מסד נתונים חדש, ולכן הנתונים הקיימים לא הוחלפו.\n\nשגיאה:\n%@"
          }
        }
      }
    },
    "crash-report.recovery.migration-hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again if the error is temporary. Start Fresh launches Snapzy with default settings — your old data stays in the sandbox container and is not deleted."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם השגיאה זמנית, יש לנסות שוב. התחלה מחדש מפעילה את Snapzy בהגדרות ברירת המחדל — הנתונים הישנים נשארים במכל האחסון המבודד ואינם נמחקים."
          }
        }
      }
    },
    "crash-report.recovery.try-again": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Again"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניסיון נוסף"
          }
        }
      }
    },
    "crash-report.recovery.start-fresh-ellipsis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Fresh…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחלה מחדש…"
          }
        }
      }
    },
    "crash-report.recovery.start-fresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Fresh"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחלה מחדש"
          }
        }
      }
    },
    "crash-report.recovery.fresh-title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start Fresh Without Old Data?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להתחיל מחדש ללא הנתונים הישנים?"
          }
        }
      }
    },
    "crash-report.recovery.fresh-message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy will launch with default settings and an empty capture history.\n\nYour old data remains in the sandbox container and is not deleted. You can access it manually at:\n~/Library/Containers/%@\n\nCurrent error:\n%@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy יופעל בהגדרות ברירת המחדל ועם היסטוריית צילום ריקה.\n\nהנתונים הישנים נשארים במכל האחסון המבודד ואינם נמחקים. ניתן לגשת אליהם ידנית בנתיב:\n~/Library/Containers/%@\n\nהשגיאה הנוכחית:\n%@"
          }
        }
      }
    },
    "crash-report.recovery.repair-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repair did not succeed. You can reset the database after backing up the current files, or quit Snapzy."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התיקון לא הצליח. ניתן לאפס את מסד הנתונים לאחר גיבוי הקבצים הנוכחיים, או לצאת מ־Snapzy."
          }
        }
      }
    },
    "crash-report.recovery.reset-initialization-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset moved the old database files aside, but Snapzy still could not create a fresh database."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האיפוס העביר הצדה את קובצי מסד הנתונים הישנים, אך Snapzy עדיין לא הצליח ליצור מסד נתונים חדש."
          }
        }
      }
    },
    "crash-report.recovery.reset-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset failed before Snapzy could create a fresh database."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האיפוס נכשל לפני יצירת מסד נתונים חדש."
          }
        }
      }
    },
    "crash-report.recovery.database-title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy could not open its database."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy לא הצליח לפתוח את מסד הנתונים שלו."
          }
        }
      }
    },
    "crash-report.recovery.database-message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy needs this database for capture history and cloud upload records.\n\nDatabase:\n%@\n\nError:\n%@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסד הנתונים דרוש ל־Snapzy לצורך היסטוריית הצילומים ורשומות ההעלאה לענן.\n\nמסד הנתונים:\n%@\n\nשגיאה:\n%@"
          }
        }
      }
    },
    "crash-report.recovery.database-hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a repair first. Reset starts with an empty database after moving the current database files into a recovery folder."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לנסות תחילה לתקן. האיפוס יתחיל במסד נתונים ריק לאחר העברת קובצי מסד הנתונים הנוכחיים לתיקיית שחזור."
          }
        }
      }
    },
    "crash-report.recovery.try-repair": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try Repair"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניסיון תיקון"
          }
        }
      }
    },
    "crash-report.recovery.reset-database-ellipsis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Database..."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איפוס מסד הנתונים..."
          }
        }
      }
    },
    "crash-report.recovery.reset-database": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Database"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איפוס מסד הנתונים"
          }
        }
      }
    },
    "crash-report.recovery.reset-title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset Snapzy Database?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לאפס את מסד הנתונים של Snapzy?"
          }
        }
      }
    },
    "crash-report.recovery.reset-message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy will move the current database files into a recovery folder, then create a new empty database.\n\nThis resets capture history and cloud upload history inside Snapzy. Capture files on disk and cloud files are not deleted.\n\nDatabase:\n%@\n\nCurrent error:\n%@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapzy יעביר את קובצי מסד הנתונים הנוכחיים לתיקיית שחזור וייצור מסד נתונים חדש וריק.\n\nהפעולה מאפסת את היסטוריית הצילומים וההעלאות לענן בתוך Snapzy. קובצי הצילום בכונן והקבצים בענן אינם נמחקים.\n\nמסד הנתונים:\n%@\n\nהשגיאה הנוכחית:\n%@"
          }
        }
      }
    },
    "crash-report.recovery.directory-failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not create database directory at %@: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן ליצור תיקייה למסד הנתונים בנתיב %@: %@"
          }
        }
      }
    },
    "crash-report.recovery.database-open-failed": {
      "extractionState": "manual",
      "localizations": {
